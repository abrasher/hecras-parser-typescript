{
  "name": "hecras-parser-typescript",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/proj4": "^2.5.6",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "@vitest/coverage-v8": "^3.2.3",
    "eslint": "^9.30.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.5.3",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@types/leaflet": "^1.9.18",
    "@types/plotly.js": "^3.0.2",
    "canvas": "^3.1.2",
    "geojson": "^0.5.0",
    "jiti": "^2.4.2",
    "leaflet": "^1.9.4",
    "plotly.js-dist-min": "^3.0.1",
    "proj4": "^2.17.0",
    "remeda": "^2.23.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --rule 'unused-imports/no-unused-imports: error'",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
