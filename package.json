{
  "name": "hecras-parser",
  "version": "0.1.1",
  "description": "A TypeScript library for parsing HEC-RAS geometry and flow files.",
  "keywords": [
    "hec-ras",
    "hecras",
    "parser",
    "hydraulics",
    "hydrology",
    "water",
    "engineering",
    "geometry",
    "flood",
    "modeling"
  ],
  "author": "Amber Shen",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abrasher/hecras-parser-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/abrasher/hecras-parser-typescript/issues"
  },
  "homepage": "https://github.com/abrasher/hecras-parser-typescript#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest run",
    "test:typecheck": "vitest --typecheck",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "publish:dry": "npm publish --dry-run",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "baseline:capture": "tsx scripts/capture-baseline.ts",
    "check:regression": "tsx scripts/check-regression.ts",
    "compare:geometries": "tsx scripts/compare-geometries.ts",
    "compare:plans": "tsx scripts/compare-plans.ts",
    "baseline:capture:plans": "tsx scripts/capture-plan-baseline.ts",
    "check:regression:plans": "tsx scripts/check-plan-regression.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.34.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^9.1.7",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "tsdown": "^0.14.2",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "es-toolkit": "^1.39.10"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --rule 'unused-imports/no-unused-imports: error'",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
